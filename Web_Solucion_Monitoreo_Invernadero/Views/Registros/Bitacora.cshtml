@model List<Web_Solucion_Monitoreo_Invernadero.Models.BitacoraRiegoAlerta>
@{
    ViewData["Title"] = "Bitácora de Riegos y Alertas";
    var invernaderos = ViewBag.Invernaderos as List<Web_Solucion_Monitoreo_Invernadero.Models.Invernadero> ?? new();
    int? invSel = ViewBag.IdInvernadero;
    string? tipoSel = ViewBag.TipoEvento;
    string? fDesde = ViewBag.FechaDesde;
    string? fHasta = ViewBag.FechaHasta;
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold text-success mb-0">Bitácora Automática de Riegos y Alertas</h2>
                <span class="badge bg-success">Actualización en vivo</span>
            </div>
            <small class="text-muted">Eventos ejecutados por umbrales críticos y calendario inteligente.</small>
        </div>
        <a asp-action="Historial" class="btn btn-outline-secondary btn-sm">Volver a Historial Ambiental</a>
    </div>

    <!-- Barra de Filtros Combinados -->
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Invernadero</label>
                    <select name="idInvernadero" class="form-select form-select-sm">
                        <option value="">Todos los invernaderos (3)</option>
                        @foreach (var inv in invernaderos)
                        {
                            <option value="@inv.IdInvernadero" selected="@(invSel == inv.IdInvernadero)">
                                @inv.Nombre
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold mb-1">Tipo de Evento</label>
                    <select name="tipoEvento" class="form-select form-select-sm">
                        <option value="">Todos los eventos</option>
                        <option value="RIEGO_EMERGENCIA" selected="@(tipoSel == "RIEGO_EMERGENCIA")">RIEGO_EMERGENCIA</option>
                        <option value="RIEGO_PROGRAMADO" selected="@(tipoSel == "RIEGO_PROGRAMADO")">RIEGO_PROGRAMADO</option>
                        <option value="RIEGO_POSPUESTO" selected="@(tipoSel == "RIEGO_POSPUESTO")">RIEGO_POSPUESTO</option>
                        <option value="ALERTA_UMBRAL" selected="@(tipoSel == "ALERTA_UMBRAL")">ALERTA_UMBRAL</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Desde</label>
                    <input type="date" name="fechaDesde" value="@fDesde" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Hasta</label>
                    <input type="date" name="fechaHasta" value="@fHasta" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Filtrar</button>
                    <a asp-action="Bitacora" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y Hora</th>
                        <th>Invernadero</th>
                        <th>Tipo Evento</th>
                        <th>Detalle</th>
                        <th>Lectura Momento</th>
                        <th>Riego (seg)</th>
                    </tr>
                </thead>
                <tbody id="tbody-bitacora">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Sin eventos registrados.</td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        string badgeClass = b.TipoEvento switch
                        {
                            "RIEGO_EMERGENCIA" => "bg-danger",
                            "RIEGO_PROGRAMADO" => "bg-primary",
                            "RIEGO_POSPUESTO" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="text-nowrap">@b.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td class="fw-semibold">@b.Invernadero?.Nombre</td>
                            <td><span class="badge @badgeClass">@b.TipoEvento</span></td>
                            <td class="small">@b.Descripcion</td>
                            <td class="small text-nowrap">H: @b.HumedadMomento% | T: @b.TemperaturaMomento°C</td>
                            <td class="fw-bold">@(b.TiempoActivacionSeg > 0 ? $"{b.TiempoActivacionSeg}s" : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/registros.js" asp-append-version="true"></script>
}