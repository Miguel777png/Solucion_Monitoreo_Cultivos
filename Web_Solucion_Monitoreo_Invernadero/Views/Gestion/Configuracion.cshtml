@model List<Web_Solucion_Monitoreo_Invernadero.Models.Invernadero>
@{
    ViewData["Title"] = "Configuración de Umbrales";
}

<div class="container py-3">
    <h2 class="fw-bold text-success mb-3">Configuración de Invernaderos y Umbrales</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var inv in Model)
        {
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white d-flex justify-content-between">
                        <span>Invernadero #@inv.IdInvernadero — @inv.Ubicacion</span>
                        <span class="badge bg-info text-dark">@inv.Planta?.Nombre</span>
                    </div>
                    <div class="card-body">
                        <form asp-action="ActualizarParametros" method="post">
                            <input type="hidden" name="idInvernadero" value="@inv.IdInvernadero" />

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Humedad Mínima (%)</label>
                                    <input type="number" step="0.1" name="humedadMinima" class="form-control" value="@inv.Planta?.HumedadMinima" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Humedad Máxima (%)</label>
                                    <input type="number" step="0.1" name="humedadMaxima" class="form-control" value="@inv.Planta?.HumedadMaxima" required />
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Temp. Mínima (°C)</label>
                                    <input type="number" step="0.1" name="temperaturaMinima" class="form-control" value="@inv.Planta?.TemperaturaMinima" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Temp. Máxima (°C)</label>
                                    <input type="number" step="0.1" name="temperaturaMaxima" class="form-control" value="@inv.Planta?.TemperaturaMaxima" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Frecuencia Guardado Histórico (minutos)</label>
                                <input type="number" min="1" max="1440" name="frecuenciaRegistroMin" class="form-control" value="@inv.FrecuenciaRegistroMin" required />
                            </div>

                            <button type="submit" class="btn btn-success w-100">Guardar Cambios</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>