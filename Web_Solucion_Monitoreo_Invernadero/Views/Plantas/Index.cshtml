@model List<Web_Solucion_Monitoreo_Invernadero.Models.Planta>
@using System.Globalization
@{
    ViewData["Title"] = "Catálogo de Plantas";
    string? busqueda = ViewBag.Busqueda;
    string? estadoFiltro = ViewBag.EstadoFiltro;
    string Numero(decimal valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
}

<div class="container py-4 plant-catalog">
    <section class="catalog-hero">
        <div>
            <span class="catalog-eyebrow">Configuración agronómica</span>
            <h1>Catálogo de plantas</h1>
            <p>Administra los límites de protección y el rango óptimo de cada especie.</p>
        </div>
        <button type="button" class="btn catalog-primary-btn" data-bs-toggle="modal" data-bs-target="#modalCrearPlanta">
            <span aria-hidden="true">＋</span> Nueva especie
        </button>
    </section>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show catalog-alert" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show catalog-alert" role="alert">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <section class="catalog-panel">
        <div class="catalog-toolbar">
            <div><h2>Especies registradas</h2><span>@Model.Count resultado@(Model.Count == 1 ? "" : "s")</span></div>
            <form method="get" class="catalog-filters">
                <input type="search" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar especie" aria-label="Buscar especie" />
                <select name="estadoFiltro" class="form-select" aria-label="Filtrar por asignación">
                    <option value="">Todas</option>
                    <option value="disponible" selected="@(estadoFiltro == "disponible")">Disponibles</option>
                    <option value="asignada" selected="@(estadoFiltro == "asignada")">Asignadas</option>
                </select>
                <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
                @if (!string.IsNullOrWhiteSpace(busqueda) || !string.IsNullOrWhiteSpace(estadoFiltro))
                { <a asp-action="Index" class="btn btn-link text-secondary">Limpiar</a> }
            </form>
        </div>

        <div class="table-responsive">
            <table class="table catalog-table align-middle mb-0">
                <thead><tr><th>Especie</th><th>Temperatura</th><th>Humedad</th><th>Asignación</th><th>Registro</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="catalog-empty"><strong>No encontramos especies</strong><span>Prueba con otro término o limpia los filtros.</span></td></tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><div class="catalog-species-name">@p.Nombre</div><div class="catalog-description">@(string.IsNullOrWhiteSpace(p.Descripcion) ? "Sin descripción" : p.Descripcion)</div></td>
                            <td><div class="threshold-stack"><span class="threshold-range">Permitido @Numero(p.TemperaturaMinima) — @Numero(p.TemperaturaMaxima) °C</span><span class="threshold-optimal">Óptimo ≥ @Numero(p.TemperaturaOptima) y &lt; @Numero(p.TemperaturaMaxima) °C</span></div></td>
                            <td><div class="threshold-stack"><span class="threshold-range">Permitido @Numero(p.HumedadMinima) — @Numero(p.HumedadMaxima) %</span><span class="threshold-optimal">Óptimo ≥ @Numero(p.HumedadOptima) y &lt; @Numero(p.HumedadMaxima) %</span></div></td>
                            <td>
                                @if (p.Invernadero != null && p.Invernadero.State)
                                { <span class="catalog-status catalog-status--assigned">@p.Invernadero.Nombre</span> }
                                else
                                { <span class="catalog-status catalog-status--available">Disponible</span> }
                            </td>
                            <td class="catalog-created-by"><span>@(p.UsuarioCreacion?.Nombre ?? $"Usuario #{p.IdUsuarioCreacion}")</span><small>@p.FechaActualizacion.ToString("dd/MM/yyyy")</small></td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm catalog-edit-btn" data-bs-toggle="modal" data-bs-target="#modalEditar-@p.IdPlanta">Editar</button>
                                <form asp-action="Eliminar" method="post" class="d-inline">
                                    <input type="hidden" name="idPlanta" value="@p.IdPlanta" />
                                    <button type="submit" class="btn btn-sm btn-link catalog-remove-btn" onclick="return confirm('¿Quitar esta planta del catálogo?');">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade plant-modal" id="modalCrearPlanta" tabindex="-1" aria-labelledby="tituloCrearPlanta" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <form asp-action="Crear" method="post" class="plant-threshold-form">
            <div class="modal-header"><div><span class="catalog-eyebrow">Nueva configuración</span><h2 class="modal-title" id="tituloCrearPlanta">Agregar especie</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-5"><label class="form-label" for="crearNombre">Nombre de la especie</label><input id="crearNombre" type="text" name="nombre" class="form-control" maxlength="100" placeholder="Ej. Orquídea Vanda" required /></div>
                    <div class="col-md-7"><label class="form-label" for="crearDescripcion">Descripción <span>(opcional)</span></label><input id="crearDescripcion" type="text" name="descripcion" class="form-control" maxlength="255" placeholder="Notas breves de cultivo" /></div>
                </div>
                <partial name="_CamposUmbrales" model="@(new Web_Solucion_Monitoreo_Invernadero.Models.Planta { TemperaturaMinima = 18, TemperaturaOptima = 21, TemperaturaMaxima = 24, HumedadMinima = 75, HumedadOptima = 80, HumedadMaxima = 85 })" />
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn catalog-primary-btn">Guardar especie</button></div>
        </form>
    </div></div>
</div>

@foreach (var p in Model)
{
    <div class="modal fade plant-modal" id="modalEditar-@p.IdPlanta" tabindex="-1" aria-labelledby="tituloEditar-@p.IdPlanta" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
            <form asp-action="Editar" method="post" class="plant-threshold-form">
                <input type="hidden" name="idPlanta" value="@p.IdPlanta" />
                <div class="modal-header"><div><span class="catalog-eyebrow">Editar configuración</span><h2 class="modal-title" id="tituloEditar-@p.IdPlanta">@p.Nombre</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
                <div class="modal-body">
                    <div class="row g-3 mb-4">
                        <div class="col-md-5"><label class="form-label">Nombre de la especie</label><input type="text" name="nombre" class="form-control" value="@p.Nombre" maxlength="100" required /></div>
                        <div class="col-md-7"><label class="form-label">Descripción <span>(opcional)</span></label><input type="text" name="descripcion" class="form-control" value="@p.Descripcion" maxlength="255" /></div>
                    </div>
                    <partial name="_CamposUmbrales" model="p" />
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn catalog-primary-btn">Guardar cambios</button></div>
            </form>
        </div></div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const groups = [
                { min: 'temperaturaMinima', optimum: 'temperaturaOptima', max: 'temperaturaMaxima', label: 'La temperatura óptima' },
                { min: 'humedadMinima', optimum: 'humedadOptima', max: 'humedadMaxima', label: 'La humedad óptima' }
            ];
            document.querySelectorAll('.plant-threshold-form').forEach(form => {
                const validate = () => {
                    let valid = true;
                    groups.forEach(group => {
                        const minimum = form.elements[group.min];
                        const optimum = form.elements[group.optimum];
                        const maximum = form.elements[group.max];
                        const minValue = Number(minimum.value);
                        const optimumValue = Number(optimum.value);
                        const maxValue = Number(maximum.value);
                        minimum.setCustomValidity('');
                        optimum.setCustomValidity('');
                        if (Number.isFinite(minValue) && Number.isFinite(maxValue) && minValue >= maxValue) {
                            minimum.setCustomValidity('El valor mínimo debe ser menor que el máximo.'); valid = false;
                        } else if (!optimum.disabled && Number.isFinite(optimumValue) && (optimumValue < minValue || optimumValue >= maxValue)) {
                            optimum.setCustomValidity(`${group.label} debe ser mayor o igual al mínimo y menor que el máximo.`); valid = false;
                        }
                    });
                    return valid;
                };
                form.querySelectorAll('[data-optimum-toggle]').forEach(toggle => {
                    const group = toggle.closest('.threshold-group');
                    const optionalField = group.querySelector('.optional-optimum-field');
                    const input = optionalField.querySelector('input');
                    const minimum = form.elements[input.name.startsWith('temperatura') ? 'temperaturaMinima' : 'humedadMinima'];
                    const maximum = form.elements[input.name.startsWith('temperatura') ? 'temperaturaMaxima' : 'humedadMaxima'];
                    const updateAutomaticValue = () => {
                        if (!toggle.checked && Number.isFinite(Number(minimum.value)) && Number.isFinite(Number(maximum.value))) {
                            input.value = ((Number(minimum.value) + Number(maximum.value)) / 2).toFixed(1);
                        }
                    };
                    const updateVisibility = () => {
                        updateAutomaticValue();
                        optionalField.classList.toggle('d-none', !toggle.checked);
                        input.disabled = !toggle.checked;
                        input.required = toggle.checked;
                        validate();
                    };
                    toggle.addEventListener('change', updateVisibility);
                    minimum.addEventListener('input', updateAutomaticValue);
                    maximum.addEventListener('input', updateAutomaticValue);
                    updateVisibility();
                });
                form.addEventListener('input', validate);
                form.addEventListener('submit', event => {
                    if (!validate() || !form.checkValidity()) { event.preventDefault(); form.reportValidity(); }
                });
            });
        })();
    </script>
}
