@model List<Web_Solucion_Monitoreo_Invernadero.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    int idUsuarioActual = ViewBag.IdUsuarioActual;
    int usuariosActivos = Model.Count(u => u.State);
    int administradores = Model.Count(u => u.Rol == "Administrador" && u.State);
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <h2 class="fw-bold text-success mb-0">Gestión de Usuarios</h2>
            <small class="text-muted">Administra las cuentas, roles y permisos de acceso al sistema.</small>
        </div>
        <button type="button" class="btn btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalCrearUsuario">
            + Agregar Usuario
        </button>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold">Usuarios registrados</div>
                    <div class="h3 fw-bold mb-0 mt-1">@Model.Count</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold">Cuentas activas</div>
                    <div class="h3 fw-bold text-success mb-0 mt-1">@usuariosActivos</div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase fw-bold">Administradores</div>
                    <div class="h3 fw-bold text-primary mb-0 mt-1">@administradores</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-bold">Cuentas del sistema</span>
            <span class="small text-muted">La contraseña nunca se muestra en el listado.</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Correo electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        bool esCuentaActual = usuario.IdUsuario == idUsuarioActual;
                        <tr class="@(esCuentaActual ? "table-success" : "")">
                            <td class="text-muted">#@usuario.IdUsuario</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="usuario-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(usuario.Nombre) ? "U" : usuario.Nombre.Trim()[0].ToString().ToUpperInvariant())</span>
                                    <div>
                                        <strong>@usuario.Nombre</strong>
                                        @if (esCuentaActual)
                                        {
                                            <div><span class="badge bg-success">Sesión actual</span></div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="badge @(usuario.Rol == "Administrador" ? "bg-primary" : "bg-secondary")">@usuario.Rol</span>
                            </td>
                            <td>
                                @if (usuario.State)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (esCuentaActual)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="No puedes editar la cuenta de tu sesión actual">Editar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#modalEditarUsuario-@usuario.IdUsuario">
                                        Editar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCrearUsuario" tabindex="-1" aria-labelledby="tituloCrearUsuario" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Crear" method="post">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" id="tituloCrearUsuario">Agregar nuevo usuario</h5>
                        <small class="text-muted">La cuenta quedará activa inmediatamente.</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="crearNombre">Nombre completo</label>
                        <input id="crearNombre" type="text" name="nombre" maxlength="100" class="form-control" required />
                        <div class="form-text">Debe ser único dentro del sistema.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="crearEmail">Correo electrónico</label>
                        <input id="crearEmail" type="email" name="email" maxlength="120" class="form-control" autocomplete="off" required />
                        <div class="form-text">Debe ser único y será utilizado para iniciar sesión.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold" for="crearPassword">Contraseña</label>
                        <input id="crearPassword" type="password" name="password" minlength="6" maxlength="255"
                               class="form-control" autocomplete="new-password" required />
                    </div>
                    <div>
                        <label class="form-label small fw-bold" for="crearRol">Rol de acceso</label>
                        <select id="crearRol" name="rol" class="form-select" required>
                            <option value="Operador">Operador</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold">Crear Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var usuario in Model.Where(u => u.IdUsuario != idUsuarioActual))
{
    <div class="modal fade" id="modalEditarUsuario-@usuario.IdUsuario" tabindex="-1"
         aria-labelledby="tituloEditarUsuario-@usuario.IdUsuario" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-action="Editar" method="post">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold" id="tituloEditarUsuario-@usuario.IdUsuario">Editar usuario</h5>
                            <small class="text-muted">ID #@usuario.IdUsuario</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="idUsuario" value="@usuario.IdUsuario" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="nombre-@usuario.IdUsuario">Nombre completo</label>
                            <input id="nombre-@usuario.IdUsuario" type="text" name="nombre" value="@usuario.Nombre"
                                   maxlength="100" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="email-@usuario.IdUsuario">Correo electrónico</label>
                            <input id="email-@usuario.IdUsuario" type="email" name="email" value="@usuario.Email"
                                   maxlength="120" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="rol-@usuario.IdUsuario">Rol de acceso</label>
                            <select id="rol-@usuario.IdUsuario" name="rol" class="form-select" required>
                                <option value="Operador" selected="@(usuario.Rol == "Operador")">Operador</option>
                                <option value="Administrador" selected="@(usuario.Rol == "Administrador")">Administrador</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold" for="password-@usuario.IdUsuario">Nueva contraseña</label>
                            <input id="password-@usuario.IdUsuario" type="password" name="nuevaPassword"
                                   minlength="6" maxlength="255" class="form-control" autocomplete="new-password" />
                            <div class="form-text">Déjala vacía para mantener la contraseña actual.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="state" value="true"
                                   id="estado-@usuario.IdUsuario" checked="@usuario.State" />
                            <input type="hidden" name="state" value="false" />
                            <label class="form-check-label fw-semibold" for="estado-@usuario.IdUsuario">Cuenta activa</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary fw-bold">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
