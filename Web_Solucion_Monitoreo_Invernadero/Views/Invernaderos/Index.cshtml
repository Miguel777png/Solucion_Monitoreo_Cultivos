@model List<Web_Solucion_Monitoreo_Invernadero.Models.Invernadero>
@{
    ViewData["Title"] = "Gestión de Invernaderos";
    var disponibles = ViewBag.PlantasDisponibles as List<Web_Solucion_Monitoreo_Invernadero.Models.Planta> ?? new();
    bool esAdmin = ViewBag.EsAdministrador == true;
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold text-success mb-0">
                @(esAdmin ? "Administración de Invernaderos y Sensores IoT" : "Asignación de Especies por Invernadero (1:1)")
            </h2>
            <small class="text-muted">
                @(esAdmin
                    ? "Crea nuevos sectores, vincula placas ESP32 y gestiona la especie de cada invernadero."
                    : "Selecciona la especie disponible que será monitoreada en cada invernadero.")
            </small>
        </div>
        <span class="badge @(esAdmin ? "bg-danger" : "bg-success") fs-6">
            @(esAdmin ? "Modo Administrador" : "Modo Operativo (Jardinero)")
        </span>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* PANEL DE INFRAESTRUCTURA: VISIBLE SOLO PARA ADMINISTRADORES *@
    @if (esAdmin)
    {
        <div class="row g-3 mb-4">
            <!-- Crear Nuevo Invernadero -->
            <div class="col-lg-6">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-header bg-success text-white fw-bold">
                        + Crear Nuevo Invernadero
                    </div>
                    <div class="card-body">
                        <form asp-action="CrearInvernadero" method="post" class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nombre del Invernadero</label>
                                <input type="text" name="nombre" class="form-control form-control-sm"
                                       placeholder="Ej: Invernadero Este" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Ubicación</label>
                                <input type="text" name="ubicacion" class="form-control form-control-sm"
                                       placeholder="Ej: Pabellón B - Sector 4" />
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small fw-bold">Especie Inicial (Disponible 1:1)</label>
                                <select name="idPlanta" class="form-select form-select-sm" required>
                                    @if (!disponibles.Any())
                                    {
                                        <option value="">-- Crea una planta libre en Catálogo primero --</option>
                                    }
                                    @foreach (var p in disponibles)
                                    {
                                        <option value="@p.IdPlanta">@p.Nombre (H: @p.HumedadMinima% - @p.HumedadMaxima%)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Guardado BD (min)</label>
                                <input type="number" name="frecuenciaRegistroMin" min="1" max="120" value="5"
                                       class="form-control form-control-sm" required />
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-success btn-sm w-100 fw-bold"
                                        disabled="@(!disponibles.Any())">
                                    Registrar Invernadero
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Registrar Nuevo Sensor ESP32 -->
            <div class="col-lg-6">
                <div class="card border-primary shadow-sm h-100">
                    <div class="card-header bg-primary text-white fw-bold">
                        + Registrar Dispositivo ESP32
                    </div>
                    <div class="card-body">
                        <form asp-action="RegistrarSensor" method="post" class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Invernadero Destino</label>
                                <select name="idInvernadero" class="form-select form-select-sm" required>
                                    @foreach (var inv in Model)
                                    {
                                        <option value="@inv.IdInvernadero">@inv.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Código Hardware (Lista Blanca)</label>
                                <input type="text" name="codigoDispositivo" class="form-control form-control-sm"
                                       placeholder="Ej: ESP32-ORQ-04" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label small fw-bold">Nombre Descriptivo del Nodo</label>
                                <input type="text" name="nombreNodo" class="form-control form-control-sm"
                                       placeholder="Ej: Sensor DHT22 + Relé Sector Este" />
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                                    Vincular ESP32 al Invernadero
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @* TARJETAS DE INVERNADEROS ACTIVOS (VISIBLE PARA AMBOS ROLES) *@
    <div class="row g-4">
        @foreach (var inv in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm h-100 border-top border-success border-4">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="fw-bold text-dark mb-0">@inv.Nombre</h5>
                            <span class="badge bg-light text-dark border">ID #@inv.IdInvernadero</span>
                        </div>
                        <small class="text-muted mb-3">@inv.Ubicacion · BD cada @inv.FrecuenciaRegistroMin min</small>

                        <!-- Sensores asociados -->
                        <div class="mb-3">
                            <div class="small fw-bold text-muted mb-1">Sensores ESP32 Vinculados:</div>
                            @if (!inv.Sensores.Any())
                            {
                                <span class="badge bg-warning text-dark">Sin ESP32 asignado</span>
                            }
                            @foreach (var s in inv.Sensores)
                            {
                                <div class="d-flex justify-content-between align-items-center bg-light border rounded px-2 py-1 mb-1 small">
                                    <div>
                                        <code>@s.CodigoDispositivo</code>
                                        <span class="badge @(s.State ? "bg-success" : "bg-secondary") ms-1">
                                            @(s.State ? "Activo" : "Inactivo")
                                        </span>
                                    </div>
                                    @if (esAdmin)
                                    {
                                        <form asp-action="AlternarEstadoSensor" method="post" class="d-inline">
                                            <input type="hidden" name="idSensor" value="@s.IdSensor" />
                                            <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none">
                                                @(s.State ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Especie actual -->
                        <div class="bg-light p-2 rounded border mb-3">
                            <div class="small text-muted">Especie Actual Asignada:</div>
                            <div class="fw-bold text-success fs-5">@inv.Planta?.Nombre</div>
                            <div class="small text-dark mt-1">
                                Humedad: <strong>@inv.Planta?.HumedadMinima% - @inv.Planta?.HumedadMaxima%</strong><br />
                                Temp: <strong>@inv.Planta?.TemperaturaMinima°C - @inv.Planta?.TemperaturaMaxima°C</strong>
                            </div>
                        </div>

                        <!-- Formulario de cambio de especie (1:1) -->
                        <form asp-action="AsignarPlanta" method="post" class="mt-auto">
                            <input type="hidden" name="idInvernadero" value="@inv.IdInvernadero" />
                            <label class="form-label small fw-bold">Cambiar Especie (Solo disponibles)</label>
                            <select name="idPlanta" class="form-select form-select-sm mb-2" required>
                                <option value="">-- Seleccionar especie libre --</option>
                                @foreach (var p in disponibles)
                                {
                                    <option value="@p.IdPlanta">
                                        @p.Nombre (H: @p.HumedadMinima%-@p.HumedadMaxima%)
                                    </option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-success btn-sm w-100 fw-bold"
                                    disabled="@(!disponibles.Any())">
                                @(disponibles.Any() ? "Asignar Nueva Especie" : "Sin plantas libres en catálogo")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>