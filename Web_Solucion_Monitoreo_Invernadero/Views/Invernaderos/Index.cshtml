@model List<Web_Solucion_Monitoreo_Invernadero.Models.Invernadero>
@{
    ViewData["Title"] = "Invernaderos";
    var seleccionado = ViewBag.Seleccionado as Web_Solucion_Monitoreo_Invernadero.Models.Invernadero;
    var plantasDisponibles = ViewBag.PlantasDisponibles as List<Web_Solucion_Monitoreo_Invernadero.Models.Planta> ?? new();
    var sensoresDisponibles = ViewBag.SensoresDisponibles as List<Web_Solucion_Monitoreo_Invernadero.Models.Sensor> ?? new();
    bool esAdmin = ViewBag.EsAdministrador == true;
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="fw-bold text-success mb-0">Gestión de Invernaderos Relación</h2>
            <small class="text-muted">
                Selecciona un invernadero de la tabla para ver su detalle y ajustar su configuración.
            </small>
        </div>
        <span class="badge @(esAdmin ? "bg-danger" : "bg-success") fs-6">
            @(esAdmin ? "Modo Administrador" : "Modo Operativo (Jardinero)")
        </span>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* FORMULARIO COMPACTO DE ALTA: SOLO ADMINISTRADOR *@
    @if (esAdmin)
    {
        <div class="card border-success shadow-sm mb-4">
            <div class="card-header bg-success text-white fw-bold py-2">
                + Crear Nuevo Invernadero
            </div>
            <div class="card-body py-3">
                <form asp-action="CrearInvernadero" method="post" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Nombre del Sector</label>
                        <input type="text" name="nombre" class="form-control form-control-sm"
                               placeholder="Ej: Invernadero Este" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Ubicación</label>
                        <input type="text" name="ubicacion" class="form-control form-control-sm"
                               placeholder="Ej: Sector D - Ala Sur" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Especie Inicial  </label>
                        <select name="idPlanta" class="form-select form-select-sm" required>
                            @if (!plantasDisponibles.Any())
                            {
                                <option value="">-- Sin especies libres --</option>
                            }
                            @foreach (var p in plantasDisponibles)
                            {
                                <option value="@p.IdPlanta">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small fw-bold mb-1">BD (min)</label>
                        <input type="number" name="frecuenciaRegistroMin" min="1" max="1440" value="60"
                               class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success btn-sm w-100 fw-bold"
                                disabled="@(!plantasDisponibles.Any())">
                            Registrar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- MAESTRO: TABLA ESCALABLE DE INVERNADEROS -->
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
                    <span class="fw-bold">Invernaderos Activos (@Model.Count)</span>
                    <input type="text" id="buscador-tabla-inv" class="form-control form-control-sm"
                           style="max-width: 220px;" placeholder="Filtrar tabla..." />
                </div>
                <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="tabla-invernaderos">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>ID</th>
                                <th>Invernadero</th>
                                <th>Especie Asignada</th>
                                <th>Sensor ESP32</th>
                                <th>BD</th>
                                <th class="text-end">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model)
                            {
                                bool activo = seleccionado != null && inv.IdInvernadero == seleccionado.IdInvernadero;
                                var sensor = inv.Sensores.FirstOrDefault(s => s.State);

                                <tr class="@(activo ? "table-success fw-semibold" : "") fila-invernadero"
                                    data-texto="@($"{inv.Nombre} {inv.Ubicacion} {inv.Planta?.Nombre} {sensor?.CodigoDispositivo}".ToLower())">
                                    <td>#@inv.IdInvernadero</td>
                                    <td>
                                        <div>@inv.Nombre</div>
                                        <small class="text-muted fw-normal">@inv.Ubicacion</small>
                                    </td>
                                    <td class="text-success">@inv.Planta?.Nombre</td>
                                    <td>
                                        @if (sensor != null)
                                        {
                                            <code>@sensor.CodigoDispositivo</code>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Sin ESP32</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@inv.FrecuenciaRegistroMin min</span></td>
                                    <td class="text-end">
                                        <a asp-action="Index" asp-route-idSeleccionado="@inv.IdInvernadero"
                                           class="btn btn-sm @(activo ? "btn-success" : "btn-outline-success")">
                                            @(activo ? "Seleccionado" : "Ver")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- DETALLE: FICHA DEL INVERNADERO SELECCIONADO -->
        <div class="col-lg-5">
            @if (seleccionado != null)
            {
                var sensorSel = seleccionado.Sensores.FirstOrDefault(s => s.State);

                <div class="card shadow-sm border-top border-success border-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-success fs-5">@seleccionado.Nombre</span>
                        <span class="badge bg-light text-dark border">ID #@seleccionado.IdInvernadero</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">@seleccionado.Ubicacion</p>

                        <!-- Resumen de Especie Actual -->
                        <div class="bg-light border rounded p-3 mb-3">
                            <div class="small text-muted">Especie Actual Monitoreada:</div>
                            <div class="fw-bold text-success fs-5">@seleccionado.Planta?.Nombre</div>
                            <div class="small mt-1">
                                Humedad óptima: <strong>@seleccionado.Planta?.HumedadMinima% - @seleccionado.Planta?.HumedadMaxima%</strong><br />
                                Temperatura óptima: <strong>@seleccionado.Planta?.TemperaturaMinima°C - @seleccionado.Planta?.TemperaturaMaxima°C</strong>
                            </div>
                        </div>

                        <!-- Formulario Operativo (Jardinero y Administrador) -->
                        <form asp-action="ActualizarConfiguracionOperativa" method="post" class="mb-4">
                            <input type="hidden" name="idInvernadero" value="@seleccionado.IdInvernadero" />

                            <div class="mb-2">
                                <label class="form-label small fw-bold">Cambiar Especie (Opcional - Solo libres )</label>
                                <select name="idNuevaPlanta" class="form-select form-select-sm">
                                    <option value="">-- Mantener actual (@seleccionado.Planta?.Nombre) --</option>
                                    @foreach (var p in plantasDisponibles)
                                    {
                                        <option value="@p.IdPlanta">
                                            @p.Nombre (H: @p.HumedadMinima%-@p.HumedadMaxima%)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold">Frecuencia Registro Histórico en BD(minutos) </label>
                                <input type="number" name="frecuenciaRegistroMin"
                                       min="1" max="1440"
                                       value="@seleccionado.FrecuenciaRegistroMin"
                                       class="form-control form-control-sm" required />
                                <div class="form-text small">Define cada cuántos minutos se guarda una fila en el historial.</div>
                            </div>

                            <button type="submit" class="btn btn-success btn-sm w-100 fw-bold">
                                Guardar Configuración Operativa
                            </button>
                        </form>

                        <hr />

                        <!-- Sección Hardware ESP32 -->
                        <div>
                            <div class="small fw-bold text-muted mb-1">Dispositivo ESP32 Vinculado:</div>
                            @if (sensorSel != null)
                            {
                                <div class="alert alert-light border py-2 px-3 small mb-2 d-flex justify-content-between align-items-center">
                                    <span><code>@sensorSel.CodigoDispositivo</code> — @sensorSel.NombreNodo</span>
                                    <span class="badge bg-success">Activo</span>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-2">
                                    Este invernadero aún no tiene un ESP32 vinculado.
                                </div>
                            }

                            @if (esAdmin)
                            {
                                <form asp-action="AsignarSensorDisponible" method="post" class="mt-2">
                                    <input type="hidden" name="idInvernadero" value="@seleccionado.IdInvernadero" />
                                    <label class="form-label small fw-bold text-primary">
                                        Vincular Sensor Disponible (Lista Blanca)
                                    </label>
                                    <div class="d-flex gap-2">
                                        <select name="idSensor" class="form-select form-select-sm" required>
                                            @if (!sensoresDisponibles.Any())
                                            {
                                                <option value="">-- No hay sensores disponibles --</option>
                                            }
                                            @foreach (var s in sensoresDisponibles)
                                            {
                                                <option value="@s.IdSensor">@s.CodigoDispositivo (@s.NombreNodo)</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm"
                                                disabled="@(!sensoresDisponibles.Any())">
                                            Vincular
                                        </button>
                                    </div>
                                    <div class="form-text small">
                                        Para autorizar un código nuevo, regístralo primero en <a asp-controller="Sensores" asp-action="Index">Sensores IoT</a>.
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscador-tabla-inv')?.addEventListener('input', function (e) {
            const filtro = (e.target && 'value' in e.target ? String(e.target.value) : '').trim().toLowerCase();
            document.querySelectorAll('.fila-invernadero').forEach(function (fila) {
                const texto = (fila.getAttribute('data-texto') || '').toLowerCase();
                fila.classList.toggle('d-none', Boolean(filtro) && !texto.includes(filtro));
            });
        });
    </script>
}