@model Web_Solucion_Monitoreo_Invernadero.Models.Invernadero
@{
    ViewData["Title"] = "Panel de Monitoreo IoT";
    var alertas = ViewBag.Alertas as List<Web_Solucion_Monitoreo_Invernadero.Models.BitacoraRiegoAlerta> ?? new();
    var listaInvernaderos = ViewBag.ListaInvernaderos as List<Web_Solucion_Monitoreo_Invernadero.Models.Invernadero> ?? new();
}

<div class="container-fluid py-3">
    <!-- Encabezado y Selector Multi-Invernadero -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="mb-0 fw-bold text-success">Monitoreo Ambiental de Orquídeas</h2>
            <small class="text-muted">
                @(Model != null ? $"{Model.Ubicacion} — Especie: {Model.Planta?.Nombre}" : "Sin invernadero seleccionado")
            </small>
        </div>

        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
            <span id="badgeConexion" class="badge bg-secondary fs-6 px-3 py-2">Verificando sensor...</span>
            @if (listaInvernaderos.Count > 1)
            {
                <select id="selectorInvernadero" class="form-select" style="width: auto;" onchange="location.href='/?idInvernadero=' + this.value">
                    @foreach (var inv in listaInvernaderos)
                    {
                        <option value="@inv.IdInvernadero" selected="@(Model?.IdInvernadero == inv.IdInvernadero)">
                            Invernadero #@inv.IdInvernadero (@inv.Planta?.Nombre)
                        </option>
                    }
                </select>
            }
        </div>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">No se encontró información del invernadero en la base de datos.</div>
    }
    else
    {
        <!-- Tarjetas de Telemetría en Tiempo Real -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-primary h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted fw-semibold">Humedad Relativa Actual</h6>
                        <div class="d-flex align-items-baseline justify-content-between mt-2">
                            <h1 id="kpiHumedad" class="display-5 fw-bold text-primary mb-0">-- %</h1>
                            <span class="badge bg-light text-dark border">
                                Rango: @Model.Planta?.HumedadMinima% - @Model.Planta?.HumedadMaxima%
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-danger h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted fw-semibold">Temperatura Ambiental</h6>
                        <div class="d-flex align-items-baseline justify-content-between mt-2">
                            <h1 id="kpiTemperatura" class="display-5 fw-bold text-danger mb-0">-- °C</h1>
                            <span class="badge bg-light text-dark border">
                                Rango: @Model.Planta?.TemperaturaMinima°C - @Model.Planta?.TemperaturaMaxima°C
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-success h-100">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted fw-semibold">Última Transmisión ESP32</h6>
                        <div class="d-flex align-items-baseline justify-content-between mt-2">
                            <h2 id="kpiHora" class="fw-bold text-dark mb-0">--:--:--</h2>
                            <span class="badge bg-light text-dark border">
                                Guardado BD: cada @Model.FrecuenciaRegistroMin min
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico en Vivo (Chart.js) + Bitácora Reciente -->
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Curva Ambiental en Tiempo Real (Memoria RAM)</span>
                        <span id="relojEnVivo" class="badge bg-dark font-monospace fs-6">--:--:--</span>
                    </div>
                    <div class="card-body">
                        <canvas id="graficoTiempoReal" height="110"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        Últimos Eventos y Riegos (MySQL)
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (!alertas.Any())
                            {
                                <li class="list-group-item text-muted text-center py-4">Sin eventos registrados aún.</li>
                            }
                            @foreach (var alerta in alertas)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <span class="badge @(alerta.TipoEvento == "RIEGO_EMERGENCIA" ? "bg-danger" : "bg-warning text-dark")">
                                            @alerta.TipoEvento
                                        </span>
                                        <small class="text-muted">@alerta.FechaHora.ToString("dd/MM HH:mm:ss")</small>
                                    </div>
                                    <p class="mb-0 mt-1 small">@alerta.Descripcion</p>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const idInvernadero = @(Model?.IdInvernadero ?? 1);
        const ctx = document.getElementById('graficoTiempoReal')?.getContext('2d');
        let chart = null;

        // Reloj en vivo segundo a segundo al lado del título del gráfico
        function actualizarReloj() {
            const reloj = document.getElementById('relojEnVivo');
            if (reloj) {
                reloj.textContent = new Date().toLocaleTimeString('es-CL');
            }
        }
        actualizarReloj();
        setInterval(actualizarReloj, 1000);

        if (ctx) {
            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: 'Humedad (%)',
                            data: [],
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.12)',
                            borderWidth: 2.5,
                            pointRadius: 3,
                            tension: 0.3,
                            fill: true
                        },
                        {
                            label: 'Temperatura (°C)',
                            data: [],
                            borderColor: '#dc3545',
                            backgroundColor: 'rgba(220, 53, 69, 0.12)',
                            borderWidth: 2.5,
                            pointRadius: 3,
                            tension: 0.3,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    animation: false, // Sin retraso de animación
                    scales: {
                        x: {
                            ticks: { display: false },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            max: 100
                        }
                    }
                }
            });
        }

        async function actualizarTelemetriaEnVivo() {
            try {
                // El parámetro ?_=${Date.now()} + cache: 'no-store' fuerza lectura directa de RAM sin caché
                const respuesta = await fetch(`/api/telemetria/actual/${idInvernadero}?_=${Date.now()}`, {
                    cache: 'no-store'
                });
                if (!respuesta.ok) return;

                const data = await respuesta.json();

                document.getElementById('kpiHumedad').textContent = `${data.humedadActual.toFixed(1)} %`;
                document.getElementById('kpiTemperatura').textContent = `${data.temperaturaActual.toFixed(1)} °C`;
                document.getElementById('kpiHora').textContent = data.ultimaHora;

                const badge = document.getElementById('badgeConexion');
                if (data.conectado) {
                    badge.className = 'badge bg-success fs-6 px-3 py-2';
                    badge.textContent = 'Sensor Conectado (En Vivo)';
                } else {
                    badge.className = 'badge bg-danger fs-6 px-3 py-2';
                    badge.textContent = 'Sensor Desconectado';
                }

                if (chart && data.historialReciente) {
                    chart.data.labels = data.historialReciente.map(p => p.hora);
                    chart.data.datasets[0].data = data.historialReciente.map(p => p.humedad);
                    chart.data.datasets[1].data = data.historialReciente.map(p => p.temperatura);
                    chart.update('none'); // Repintado inmediato en el canvas
                }
            } catch (error) {
                console.error('Error al consultar telemetría:', error);
            }
        }

        // Primera carga inmediata y polling rápido cada 800 ms
        actualizarTelemetriaEnVivo();
        setInterval(actualizarTelemetriaEnVivo, 800);
    </script>
}