@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-page">
    <div class="login-shell">
        <aside class="login-visual" aria-label="Sistema de monitoreo de invernaderos">
            <div class="login-brand">
                <span class="login-brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 21c-1.2-4.7.1-9.4 4.1-13.4M12.5 17.3c2.2.4 4.4-.2 5.8-1.8 1.4-1.6 1.8-3.9 1.1-6-2.2-.1-4.3.8-5.6 2.5-1.2 1.5-1.7 3.4-1.3 5.3ZM10.9 13.5c-2.1.1-4.1-.8-5.3-2.4-1.2-1.6-1.5-3.8-.7-5.7 2.1 0 4 .9 5.2 2.5 1.1 1.6 1.4 3.6.8 5.6Z" />
                    </svg>
                </span>
                <span>
                    <strong>Orquídeas IoT</strong>
                    <small>Monitoreo inteligente</small>
                </span>
            </div>

            <div class="login-visual-copy">
                <span class="login-eyebrow">CONTROL AMBIENTAL EN TIEMPO REAL</span>
                <h1>Cultivos conectados, decisiones más precisas.</h1>
                <p>Supervisa la humedad, temperatura y programación de riego de cada invernadero desde un único lugar.</p>
            </div>

            <div class="login-metrics" aria-label="Parámetros ambientales de referencia">
                <div class="login-metric">
                    <span class="metric-icon metric-icon--temperature" aria-hidden="true">°</span>
                    <span><strong>18–24 °C</strong><small>Temperatura óptima</small></span>
                </div>
                <div class="login-metric">
                    <span class="metric-icon metric-icon--humidity" aria-hidden="true">%</span>
                    <span><strong>80%</strong><small>Humedad de referencia</small></span>
                </div>
            </div>

            <svg class="login-orchid" viewBox="0 0 420 340" aria-hidden="true">
                <path class="orchid-stem" d="M209 340c-4-83 2-162 53-230" />
                <path class="orchid-stem" d="M218 273c-26-44-66-69-111-83" />
                <path class="orchid-leaf" d="M212 286c-56-7-94 10-119 46 57 8 97-7 119-46Z" />
                <path class="orchid-leaf" d="M224 306c45-12 81-2 109 29-45 11-81 2-109-29Z" />
                <g class="orchid-flower" transform="translate(263 104)">
                    <ellipse cx="0" cy="-31" rx="22" ry="39" />
                    <ellipse cx="31" cy="-4" rx="22" ry="39" transform="rotate(66 31 -4)" />
                    <ellipse cx="19" cy="31" rx="20" ry="35" transform="rotate(145 19 31)" />
                    <ellipse cx="-21" cy="30" rx="20" ry="35" transform="rotate(215 -21 30)" />
                    <ellipse cx="-32" cy="-6" rx="22" ry="39" transform="rotate(294 -32 -6)" />
                    <circle cx="0" cy="3" r="14" />
                </g>
                <g class="orchid-flower orchid-flower--small" transform="translate(111 188) scale(.72)">
                    <ellipse cx="0" cy="-31" rx="22" ry="39" />
                    <ellipse cx="31" cy="-4" rx="22" ry="39" transform="rotate(66 31 -4)" />
                    <ellipse cx="19" cy="31" rx="20" ry="35" transform="rotate(145 19 31)" />
                    <ellipse cx="-21" cy="30" rx="20" ry="35" transform="rotate(215 -21 30)" />
                    <ellipse cx="-32" cy="-6" rx="22" ry="39" transform="rotate(294 -32 -6)" />
                    <circle cx="0" cy="3" r="14" />
                </g>
            </svg>
        </aside>

        <div class="login-panel">
            <div class="login-form-wrap">
                <div class="login-heading">
                    <span class="login-mobile-mark" aria-hidden="true">OI</span>
                    <h2>Bienvenido</h2>
                    <p>Ingresa tus credenciales para acceder al sistema.</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="login-error" role="alert">
                        <span aria-hidden="true">!</span>
                        <div><strong>No fue posible ingresar</strong><small>@ViewBag.Error</small></div>
                    </div>
                }

                <form asp-action="Login" method="post" class="login-form">
                    <div class="login-field">
                        <label for="email">Correo electrónico</label>
                        <div class="login-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 6.5h18v11H3zM3.8 7.2 12 13l8.2-5.8" />
                            </svg>
                            <input id="email" type="email" name="email" placeholder="nombre@invernadero.cl"
                                   autocomplete="username" inputmode="email" required autofocus />
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="password">Contraseña</label>
                        <div class="login-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10M12 14v2" />
                            </svg>
                            <input id="password" type="password" name="password" placeholder="Ingresa tu contraseña"
                                   autocomplete="current-password" required />
                            <button class="password-toggle" type="button" aria-label="Mostrar contraseña" aria-pressed="false" data-password-toggle>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-5 9.5-5 9.5 5 9.5 5-3.5 5-9.5 5-9.5-5-9.5-5Z" />
                                    <circle cx="12" cy="12" r="2.5" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="login-submit">
                        <span>Ingresar al sistema</span>
                        <span class="login-submit-arrow" aria-hidden="true">→</span>
                    </button>
                </form>

                <div class="login-session-note">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z" />
                        <path d="m9.2 12 1.8 1.8 3.9-4" />
                    </svg>
                    <span>Sesión protegida y recordada durante 4 horas.</span>
                </div>

                <details class="demo-accounts">
                    <summary>Credenciales de demostración</summary>
                    <div class="demo-account-list">
                        <div><span>Administrador</span><code>admin@invernadero.cl</code><small>Clave: 123456</small></div>
                        <div><span>Operador</span><code>operador@invernadero.cl</code><small>Clave: 123456</small></div>
                    </div>
                </details>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const button = document.querySelector('[data-password-toggle]');
            const input = document.getElementById('password');

            button?.addEventListener('click', () => {
                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                button.setAttribute('aria-pressed', String(!showing));
                button.setAttribute('aria-label', showing ? 'Mostrar contraseña' : 'Ocultar contraseña');
            });
        })();
    </script>
}
