@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión — Monitoreo Invernadero";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
    <div class="card shadow border-0" style="width: 100%; max-width: 410px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h4 class="fw-bold text-success mb-1">Invernadero IoT</h4>
                <p class="text-muted small mb-0">Ingrese sus credenciales para continuar</p>
            </div>

            @if (TempData["MensajeError"] != null)
            {
                <div class="alert alert-danger py-2 small">
                    @TempData["MensajeError"]
                </div>
            }

            <form asp-controller="Auth" asp-action="IniciarSesion" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label small fw-bold">Correo electrónico</label>
                    <input type="email" name="correo" class="form-control"
                           placeholder="usuario@invernadero.cl" required autofocus />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold">Contraseña</label>
                    <input type="password" name="password" class="form-control"
                           placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-success w-100 fw-bold">
                    Ingresar
                </button>
            </form>
        </div>
    </div>
</body>
</html>