@using Microsoft.AspNetCore.Http
@{
    int? idUser = Context.Session.GetInt32("IdUsuario");
    string nombreUser = Context.Session.GetString("NombreUsuario") ?? "Sin sesión";
    string rolUser = Context.Session.GetString("RolUsuario") ?? "";
    bool esAdmin = rolUser.Equals("Administrador", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Orquídeas IoT</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-success" asp-controller="Monitoreo" asp-action="Index">
                    Orquídeas IoT
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Monitoreo" asp-action="Index">Monitor en Vivo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Plantas" asp-action="Index">Catálogo Plantas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Invernaderos" asp-action="Index">
                                @(esAdmin ? "Invernaderos y Sensores" : "Invernaderos (1:1)")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Calendario" asp-action="Index">Calendario Riego</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Registros" asp-action="Historial">Historial Ambiental</a>
                        </li>
                        @if (esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Registros" asp-action="Auditoria">Auditoría Usuarios</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border py-2 px-3">
                            @nombreUser
                            <span class="badge @(esAdmin ? "bg-danger" : "bg-success") ms-1">@rolUser</span>
                        </span>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                            Cerrar Sesión
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container small text-center">
            &copy; 2026 - Sistema de Monitoreo y Riego Automatizado de Orquídeas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>